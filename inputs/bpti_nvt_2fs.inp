[INPUT]
grotopfile = data/bpti/bpti.top
grocrdfile = data/bpti/bpti.gro
rstfile    = data/bpti/rst

[OUTPUT]

[ENERGY]
forcefield       = GROAMBER
electrostatic    = PME
switchdist       = 12.0
cutoffdist       = 12.0
pairlistdist     = 14.0
dielec_const     = 1.0
pme_alpha        = 0.34
pme_ngrid_x      = 64
pme_ngrid_y      = 64
pme_ngrid_z      = 64
pme_nspline      = 4
nonbond_kernel   = GPU

[DYNAMICS]
integrator       = VVER
iseed            = 314159
nsteps           = 100000
timestep         = 0.002
eneout_period    = 1000
nbupdate_period  = 10
thermostat_period = 10

[CONSTRAINTS]
rigid_bond       = YES
water_model      = SOL

[ENSEMBLE]
ensemble         = NVT
tpcontrol        = BUSSI
temperature      = 300
group_tp         = YES

[BOUNDARY]
type             = PBC
domain_x         = 1
domain_y         = 1
domain_z         = 1
