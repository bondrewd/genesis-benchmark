[INPUT]
prmtopfile = data/factorix/FactorIX.prmtop
ambcrdfile = data/factorix/FactorIX.inpcrd
rstfile    = data/factorix/rst

[OUTPUT]

[ENERGY]
forcefield       = AMBER
electrostatic    = PME
switchdist       = 8
cutoffdist       = 8
pairlistdist     = 9.5
pme_nspline      = 4
nonbond_kernel   = GPU

[DYNAMICS]
integrator       = VVER
iseed            = 314159
nsteps           = 100000
timestep         = 0.002
eneout_period    = 1000
nbupdate_period  = 10
thermostat_period = 10
barostat_period  = 10
baroscale_period = 10

[CONSTRAINTS]
rigid_bond       = YES
water_model      = WAT
hydrogen_mass_upper_bound = 3.3

[ENSEMBLE]
ensemble         = NPT
tpcontrol        = BUSSI
temperature      = 300
pressure         = 1.0
group_tp         = YES

[BOUNDARY]
type             = PBC

