[INPUT]
prmtopfile = data/dhfr/step3_input.parm7
ambcrdfile = data/dhfr/step3_input.rst7
rstfile    = data/dhfr/equil.rst

[OUTPUT]

[ENERGY]
forcefield       = AMBER
electrostatic    = PME
switchdist       = 8
cutoffdist       = 8
pairlistdist     = 9.5
pme_ngrid_x      = 48
pme_ngrid_y      = 48
pme_ngrid_z      = 48
pme_nspline      = 4
nonbond_kernel   = GPU

[DYNAMICS]
integrator       = VVER
iseed            = 314159
nsteps           = 100000
timestep         = 0.002
eneout_period    = 1000
nbupdate_period  = 10

[CONSTRAINTS]
rigid_bond       = YES
water_model      = WAT

[ENSEMBLE]
ensemble         = NVE
tpcontrol        = NO
temperature      = 300
group_tp         = YES

[BOUNDARY]
type             = PBC
box_size_x       = 1
box_size_y       = 1
box_size_z       = 1

