[INPUT]
prmtopfile        = data/dhfr/prmtop
ambcrdfile        = data/dhfr/inpcrd

[ENERGY]
forcefield        = AMBER
electrostatic     = PME
switchdist        = 8
cutoffdist        = 8
pairlistdist      = 9.5
pme_ngrid_x       = 48
pme_ngrid_y       = 48
pme_ngrid_z       = 48
pme_nspline       = 4

[DYNAMICS]
integrator        = VVER
iseed             = 314159
nsteps            = 100000
timestep          = 0.002
eneout_period     = 1000
thermostat_period = 10
barostat_period   = 10
baroscale_period  = 10

[CONSTRAINTS]
rigid_bond        = YES
cons_scheme       = MSHAKE
iter_solute       = 3
iter_water        = 3

[ENSEMBLE]
ensemble          = NPT
tpcontrol         = BUSSI
temperature       = 300
pressure          = 1.0

[BOUNDARY]
type              = PBC
box_size_x        = 62.23
box_size_y        = 62.23
box_size_z        = 62.23
