[INPUT]
prmtopfile    = data/stmv/prmtop
ambcrdfile    = data/stmv/inpcrd

[ENERGY]
forcefield    = AMBER
electrostatic = PME
switchdist    = 8
cutoffdist    = 8
pairlistdist  = 9.5
pme_nspline   = 4

[DYNAMICS]
integrator    = VVER
iseed         = 314159
nsteps        = 100000
timestep      = 0.002
eneout_period = 1000

[CONSTRAINTS]
rigid_bond    = YES
cons_scheme   = MSHAKE-SETTLE
iter_solute   = 2

[ENSEMBLE]
ensemble      = NVE
tpcontrol     = NO
temperature   = 300

[BOUNDARY]
type          = PBC
box_size_x    = 221.1723142
box_size_y    = 223.1988809
box_size_z    = 224.4925841
