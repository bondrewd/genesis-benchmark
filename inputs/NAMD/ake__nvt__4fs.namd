cellOrigin 43.24706725 41.63158495 43.5846661
wrapAll on
cutoff 9
switching off
switchdist 9
pairlistdist 11
PME yes
PMEGridSpacing 1.0
PMETolerance 1.0e-5
zeroMomentum no
GPUresident on
nonbondedFreq 1
fullElectFrequency 1
timestep 4
rigidBonds all
useSettle on
seed 314159
temperature 300
outputName ake__nvt__4fs
outputEnergies 1000
outputTiming 1000
DCDfreq 0
restartfreq 0
XSTFreq 0
stochRescale on
