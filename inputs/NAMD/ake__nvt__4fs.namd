# baroscale-period-steps: 5
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none
# hmr-authority: native-topology heavy-atom mass transfer; rigid waters excluded
