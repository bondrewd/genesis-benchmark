# Generated by generate_inputs.py
# benchmark-system: bpti
# native-model: native_amber03_tip3p
# forcefield-family: AMBER
# forcefield: Amber03
# water-model: TIP3P
# solvent: explicit
# source: data/variants/bpti/native_amber03_tip3p/variant.json
# execution-profile: matched
# post-neutralization-charge-e: 1.9615635787734696e-06
# neutralization-method: none_required
# ensemble: nve
# dt-fs: 4
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 5
# barostat-period-steps: 5
# baroscale-period-steps: 5
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none
# hmr-authority: native-topology heavy-atom mass transfer; rigid waters excluded
# hmr-hydrogen-mass-dalton: 3.024
# hmr-ratio: 3
# Compatibility: NAMD uses velocity Verlet, SETTLE plus SHAKE for solute,
# and solute constraints that are not M-SHAKE.
# The matched NPT route uses a Langevin piston. Piston period/decay are
# physical fs values, and there is no separate baroscale-cadence mapping.
amber on
oldParmReader off
parmfile ../../data/variants/bpti/native_amber03_tip3p/system_hmr.prmtop
ambercoor ../../data/variants/bpti/native_amber03_tip3p/system.inpcrd
readexclusions yes
exclude scaled1-4
oneFourScaling 0.83330000133328
scnb 2
cellBasisVector1 65.3318 0 0
cellBasisVector2 0 65.3318 0
cellBasisVector3 0 0 65.3318
cellOrigin 32.6659 32.6659 32.6659
wrapAll on
cutoff 9
switching off
switchdist 9
pairlistdist 11
PME yes
PMEGridSpacing 1.0
PMETolerance 1.0e-5
zeroMomentum no
GPUresident on
nonbondedFreq 1
fullElectFrequency 1
timestep 4
rigidBonds all
useSettle on
seed 314159
temperature 300
outputName bpti__nve__4fs
outputEnergies 1000
outputTiming 1000
DCDfreq 0
restartfreq 0
XSTFreq 0
run 100000
