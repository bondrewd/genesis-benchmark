# Generated by generate_inputs.py
# benchmark-system: dhfr
# native-model: native_amber_jac_tip3p
# forcefield-family: AMBER
# forcefield: archive-AMBER-JAC
# water-model: TIP3P
# solvent: explicit
# source: data/variants/dhfr/native_amber_jac_tip3p/variant.json
# execution-profile: matched
# post-neutralization-charge-e: -6.146314952219095e-08
# neutralization-method: replace_waters
# ensemble: nvt
# dt-fs: 2
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 10
# barostat-period-steps: 10
# baroscale-period-steps: 10
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none
# Compatibility: NAMD uses velocity Verlet, SETTLE plus SHAKE for solute,
# and solute constraints that are not M-SHAKE.
# The matched NPT route uses a Langevin piston. Piston period/decay are
# physical fs values, and there is no separate baroscale-cadence mapping.
amber on
oldParmReader off
parmfile ../../data/variants/dhfr/native_amber_jac_tip3p/system.prmtop
ambercoor ../../data/variants/dhfr/native_amber_jac_tip3p/system.inpcrd
readexclusions yes
exclude scaled1-4
oneFourScaling 0.8333333333333334
scnb 2
cellBasisVector1 62.23 0 0
cellBasisVector2 0 62.23 0
cellBasisVector3 0 0 62.23
cellOrigin 31.115 31.115 31.115
wrapAll on
cutoff 9
switching off
switchdist 9
pairlistdist 11
PME yes
PMEGridSpacing 1.0
PMETolerance 1.0e-5
zeroMomentum no
GPUresident on
nonbondedFreq 1
fullElectFrequency 1
timestep 2
rigidBonds all
useSettle on
seed 314159
temperature 300
outputName dhfr__nvt__2fs
outputEnergies 1000
outputTiming 1000
DCDfreq 0
restartfreq 0
XSTFreq 0
stochRescale on
stochRescaleTemp 300
stochRescalePeriod 5
stochRescaleFreq 10
run 100000
