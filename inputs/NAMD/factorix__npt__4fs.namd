# Generated by generate_inputs.py
# benchmark-system: factorix
# native-model: native_archive_amber_factorix_3site
# forcefield-family: AMBER
# forcefield: custom-factorix
# water-model: TIP3P
# solvent: explicit
# source: data/variants/factorix/native_archive_amber_factorix_3site/variant.json
# execution-profile: matched
# post-neutralization-charge-e: 0.00031225015483362555
# neutralization-method: none_required
# ensemble: npt
# dt-fs: 4
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 5
# barostat-period-steps: 5
# baroscale-period-steps: 5
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none
# hmr-authority: native-topology heavy-atom mass transfer; rigid waters excluded
# hmr-hydrogen-mass-dalton: 3.024
# hmr-ratio: 3
# Compatibility: NAMD uses velocity Verlet, SETTLE plus SHAKE for solute,
# and solute constraints that are not M-SHAKE.
# The matched NPT route uses a Langevin piston. Piston period/decay are
# physical fs values, and there is no separate baroscale-cadence mapping.
amber on
oldParmReader off
parmfile ../../data/variants/factorix/native_archive_amber_factorix_3site/system_hmr.prmtop
ambercoor ../../data/variants/factorix/native_archive_amber_factorix_3site/system.inpcrd
readexclusions yes
exclude scaled1-4
oneFourScaling 0.8333333333333334
scnb 2
cellBasisVector1 142.0855468 0 0
cellBasisVector2 0 83.3368905 0
cellBasisVector3 0 0 78.6783548
cellOrigin 71.0427734 41.66844525 39.3391774
wrapAll on
cutoff 9
switching off
switchdist 9
pairlistdist 11
PME yes
PMEGridSpacing 1.0
PMETolerance 1.0e-5
zeroMomentum no
GPUresident on
nonbondedFreq 1
fullElectFrequency 1
timestep 4
rigidBonds all
useSettle on
seed 314159
temperature 300
outputName factorix__npt__4fs
outputEnergies 1000
outputTiming 1000
DCDfreq 0
restartfreq 0
XSTFreq 0
stochRescale on
stochRescaleTemp 300
stochRescalePeriod 5
stochRescaleFreq 5
useGroupPressure yes
langevinPiston on
langevinPistonTarget 1.01325
langevinPistonPeriod 100
langevinPistonDecay 50
langevinPistonTemp 300
run 100000
