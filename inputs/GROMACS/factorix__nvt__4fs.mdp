; Generated by generate_inputs.py
; benchmark-system: factorix
; native-model: native_archive_amber_factorix_3site
; forcefield-family: AMBER
; forcefield: custom-factorix
; water-model: TIP3P
; solvent: explicit
; source: data/variants/factorix/native_archive_amber_factorix_3site/variant.json
; execution-profile: matched
; post-neutralization-charge-e: 0.00031225015483362555
; neutralization-method: none_required
; ensemble: nvt
; dt-fs: 4
; nsteps: 100000
; output-period-steps: 1000
; thermostat-period-steps: 5
; barostat-period-steps: 5
; baroscale-period-steps: 5
; temperature-k: 300
; pressure-atm: 1
; tau-t-ps: 5
; tau-p-ps: 5
; random-seed: 314159
; cutoff-angstrom: 9
; pair-list-skin-angstrom: 2
; vdw-switch-semantic: none
; hmr-authority: native-topology heavy-atom mass transfer; rigid waters excluded
; hmr-hydrogen-mass-dalton: 3.024
; hmr-ratio: 3
; topology: data/variants/factorix/native_archive_amber_factorix_3site/system_hmr.top
; coordinates: data/variants/factorix/native_archive_amber_factorix_3site/system.g96
; Compatibility: md-vv couples the v-rescale thermostat every step; LINCS
; replaces M-SHAKE and C-rescale replaces a Langevin barostat.
; C-rescale has no separate mapping for the requested baroscale cadence.
; Run mdrun with -tunepme no to preserve the requested real-space protocol.
integrator = md-vv
dt = 0.004
nsteps = 100000
nstlog = 1000
nstcalcenergy = 1000
nstenergy = 1000
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 0
continuation = no
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 6
lincs-iter = 2
cutoff-scheme = Verlet
rcoulomb = 0.9
rvdw = 0.9
coulombtype = PME
coulomb-modifier = None
ewald-rtol = 1.0e-5
vdwtype = Cut-off
pme-order = 4
fourierspacing = 0.1
gen-vel = yes
gen-temp = 300
gen-seed = 314159
ld-seed = 314159
comm-mode = None
nstcomm = 0
nstlist = 5
verlet-buffer-tolerance = -1
rlist = 1.1
vdw-modifier = None
tcoupl = v-rescale
nsttcouple = 1
tc-grps = System
tau-t = 5
ref-t = 300
pcoupl = no
