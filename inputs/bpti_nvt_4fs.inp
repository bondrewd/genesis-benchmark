[INPUT]
grotopfile                = data/bpti/bpti.top
grocrdfile                = data/bpti/bpti.gro
rstfile                   = data/bpti/rst

[ENERGY]
forcefield                = GROAMBER
electrostatic             = PME
switchdist                = 12.0
cutoffdist                = 12.0
pairlistdist              = 14.0
dielec_const              = 1.0
pme_alpha                 = 0.34
pme_ngrid_x               = 64
pme_ngrid_y               = 64
pme_ngrid_z               = 64
pme_nspline               = 4

[DYNAMICS]
integrator                = VVER
iseed                     = 314159
nsteps                    = 100000
timestep                  = 0.004
hydrogen_mr               = YES
hmr_target                = all
hmr_ratio                 = 3.0
eneout_period             = 1000
thermostat_period         = 5

[CONSTRAINTS]
rigid_bond                = YES
cons_scheme               = MSHAKE
iter_solute               = 3
iter_water                = 3
hydrogen_mass_upper_bound = 3.3

[ENSEMBLE]
ensemble                  = NVT
tpcontrol                 = BUSSI
temperature               = 300

[BOUNDARY]
type                      = PBC
domain_x                  = 1
domain_y                  = 1
domain_z                  = 1
