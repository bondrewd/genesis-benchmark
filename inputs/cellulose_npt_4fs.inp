[INPUT]
prmtopfile                = data/cellulose/prmtop
ambcrdfile                = data/cellulose/inpcrd

[ENERGY]
forcefield                = AMBER
electrostatic             = PME
switchdist                = 8
cutoffdist                = 8
pairlistdist              = 9.5
pme_nspline               = 4

[DYNAMICS]
integrator                = VVER
iseed                     = 314159
nsteps                    = 100000
timestep                  = 0.004
hydrogen_mr               = YES
hmr_target                = all
hmr_ratio                 = 3.0
eneout_period             = 1000
thermostat_period         = 5
barostat_period           = 5
baroscale_period          = 5

[CONSTRAINTS]
rigid_bond                = YES
cons_scheme               = MSHAKE-SETTLE
iter_solute               = 2
hydrogen_mass_upper_bound = 3.3

[ENSEMBLE]
ensemble                  = NPT
tpcontrol                 = BUSSI
temperature               = 300
pressure                  = 1.0

[BOUNDARY]
type                      = PBC
box_size_x                = 259.2299548
box_size_y                = 124.5580494
box_size_z                = 123.5021394
