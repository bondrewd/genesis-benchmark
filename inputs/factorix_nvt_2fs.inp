[INPUT]
prmtopfile        = data/factorix/FactorIX.prmtop
ambcrdfile        = data/factorix/FactorIX.inpcrd

[ENERGY]
forcefield        = AMBER
electrostatic     = PME
switchdist        = 8
cutoffdist        = 8
pairlistdist      = 9.5
pme_nspline       = 4

[DYNAMICS]
integrator        = VVER
iseed             = 314159
nsteps            = 100000
timestep          = 0.002
eneout_period     = 1000
thermostat_period = 10

[CONSTRAINTS]
rigid_bond        = YES
cons_scheme       = MSHAKE-SETTLE
iter_solute       = 2

[ENSEMBLE]
ensemble          = NVT
tpcontrol         = BUSSI
temperature       = 300

[BOUNDARY]
type              = PBC
box_size_x        = 142.0855468
box_size_y        = 83.3368905
box_size_z        = 78.6783548
