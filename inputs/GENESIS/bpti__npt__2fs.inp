# Generated by generate_inputs.py
# benchmark-system: bpti
# native-model: native_amber03_tip3p
# forcefield-family: AMBER
# forcefield: Amber03
# water-model: TIP3P
# solvent: explicit
# source: data/variants/bpti/native_amber03_tip3p/variant.json
# execution-profile: matched
# post-neutralization-charge-e: 1.9615635787734696e-06
# neutralization-method: none_required
# ensemble: npt
# dt-fs: 2
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 10
# barostat-period-steps: 10
# baroscale-period-steps: 10
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none

[INPUT]
prmtopfile        = data/variants/bpti/native_amber03_tip3p/system.prmtop
ambcrdfile        = data/variants/bpti/native_amber03_tip3p/system.inpcrd

[ENERGY]
forcefield        = AMBER
electrostatic     = PME
switchdist        = 9
cutoffdist        = 9
pairlistdist      = 11
pme_nspline       = 4
pme_alpha_tol     = 1.0e-5
pme_ngrid_x       = 64
pme_ngrid_y       = 64
pme_ngrid_z       = 64

[DYNAMICS]
integrator        = VVER
iseed             = 314159
stoptr_period     = 0
nsteps            = 100000
timestep          = 0.002
eneout_period     = 1000
crdout_period     = 0
rstout_period     = 0
thermostat_period = 10
barostat_period   = 10
baroscale_period  = 10

[CONSTRAINTS]
rigid_bond        = YES
cons_scheme       = MSHAKE-SETTLE
iter_solute       = 2

[ENSEMBLE]
ensemble          = NPT
thermostat        = BUSSI
barostat          = LANGEVIN
temperature       = 300
tau_t             = 5
pressure          = 1
tau_p             = 5

[BOUNDARY]
type              = PBC
box_size_x        = 65.3318
box_size_y        = 65.3318
box_size_z        = 65.3318
domain_x          = 1
domain_y          = 1
domain_z          = 1
