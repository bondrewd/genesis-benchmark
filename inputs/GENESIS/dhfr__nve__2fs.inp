# Generated by generate_inputs.py
# benchmark-system: dhfr
# native-model: native_amber_jac_tip3p
# forcefield-family: AMBER
# forcefield: archive-AMBER-JAC
# water-model: TIP3P
# solvent: explicit
# source: data/variants/dhfr/native_amber_jac_tip3p/variant.json
# execution-profile: matched
# post-neutralization-charge-e: -6.146314952219095e-08
# neutralization-method: replace_waters
# ensemble: nve
# dt-fs: 2
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 10
# barostat-period-steps: 10
# baroscale-period-steps: 10
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 9
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: none

[INPUT]
prmtopfile    = data/variants/dhfr/native_amber_jac_tip3p/system.prmtop
ambcrdfile    = data/variants/dhfr/native_amber_jac_tip3p/system.inpcrd

[ENERGY]
forcefield    = AMBER
electrostatic = PME
switchdist    = 9
cutoffdist    = 9
pairlistdist  = 11
pme_nspline   = 4
pme_alpha_tol = 1.0e-5
pme_ngrid_x   = 48
pme_ngrid_y   = 48
pme_ngrid_z   = 48

[DYNAMICS]
integrator    = VVER
iseed         = 314159
stoptr_period = 0
nsteps        = 100000
timestep      = 0.002
eneout_period = 1000
crdout_period = 0
rstout_period = 0

[CONSTRAINTS]
rigid_bond    = YES
cons_scheme   = MSHAKE-SETTLE
iter_solute   = 2

[ENSEMBLE]
ensemble      = NVE
thermostat    = NONE
barostat      = NONE
temperature   = 300

[BOUNDARY]
type          = PBC
box_size_x    = 62.23
box_size_y    = 62.23
box_size_z    = 62.23
