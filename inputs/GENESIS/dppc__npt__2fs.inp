# Generated by generate_inputs.py
# benchmark-system: dppc
# native-model: native_charmm36lipid_mtip3p
# forcefield-family: CHARMM
# forcefield: CHARMM36lipid
# water-model: mTIP3P
# solvent: explicit
# source: data/variants/dppc/native_charmm36lipid_mtip3p/variant.json
# execution-profile: matched
# post-neutralization-charge-e: 0
# neutralization-method: none_required
# ensemble: npt
# dt-fs: 2
# nsteps: 100000
# output-period-steps: 1000
# thermostat-period-steps: 10
# barostat-period-steps: 10
# baroscale-period-steps: 10
# temperature-k: 300
# pressure-atm: 1
# tau-t-ps: 5
# tau-p-ps: 5
# random-seed: 314159
# cutoff-angstrom: 12
# pair-list-skin-angstrom: 2
# vdw-switch-semantic: force

[INPUT]
topfile           = data/variants/dppc/native_charmm36lipid_mtip3p/top_all36_lipid.rtf,\
data/variants/dppc/native_charmm36lipid_mtip3p/water_ions.rtf
parfile           = data/variants/dppc/native_charmm36lipid_mtip3p/par_all36_lipid.prm,\
data/variants/dppc/native_charmm36lipid_mtip3p/water_ions.prm,\
data/variants/dppc/native_charmm36lipid_mtip3p/water_ions_nbfix.prm
psffile           = data/variants/dppc/native_charmm36lipid_mtip3p/system.psf
crdfile           = data/variants/dppc/native_charmm36lipid_mtip3p/system.crd

[ENERGY]
forcefield        = CHARMM
electrostatic     = PME
switchdist        = 10
cutoffdist        = 12
pairlistdist      = 14
vdw_force_switch  = YES
pme_nspline       = 4
pme_alpha_tol     = 1.0e-5
pme_ngrid_x       = 72
pme_ngrid_y       = 72
pme_ngrid_z       = 72

[DYNAMICS]
integrator        = VVER
iseed             = 314159
stoptr_period     = 0
nsteps            = 100000
timestep          = 0.002
eneout_period     = 1000
crdout_period     = 0
rstout_period     = 0
thermostat_period = 10
barostat_period   = 10
baroscale_period  = 10

[CONSTRAINTS]
rigid_bond        = YES
cons_scheme       = MSHAKE-SETTLE
iter_solute       = 2

[ENSEMBLE]
ensemble          = NPT
thermostat        = BUSSI
barostat          = LANGEVIN
temperature       = 300
tau_t             = 5
pressure          = 1
tau_p             = 5

[BOUNDARY]
type              = PBC
box_size_x        = 69.47812837130373
box_size_y        = 69.47812837130373
box_size_z        = 71.64969487712301
domain_x          = 1
domain_y          = 1
domain_z          = 1
